root = true

# Helm templates are Go templates that happen to have a .yaml extension. A YAML formatter rewrites
# {{ .Values.x }} as { { .Values.x } }, which stops Helm recognising the delimiter and leaves the file
# invalid. Keep the formatter away from them.
[helm/**/templates/*.yaml]
ij_formatter_enabled = false

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space

[*.{yaml,yml}]
indent_size = 2

[*.java]
indent_size = 4
max_line_length = 120
